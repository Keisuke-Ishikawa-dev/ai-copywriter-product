{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["seo_title", "seo_description", "key_characteristics", "search_queries", "commercial_block", "missing_data", "assumptions", "questions"],
  "properties": {
    "seo_title": {"type": "string", "maxLength": 70},
    "seo_description": {"type": "string", "minLength": 800, "maxLength": 1200},
    "key_characteristics": {"type": "array", "items": {"type": "string"}},
    "search_queries": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string"}},
    "commercial_block": {"type": "string"},
    "missing_data": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
